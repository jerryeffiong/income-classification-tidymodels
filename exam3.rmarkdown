  labs(title = "Age Distribution by Income Class",
       x     = "Age (years)",
       y     = "Density",
       fill  = "Income",
       colour = "Income") +
  theme_minimal(base_size = 14) +
  theme(
    plot.background    = element_rect(fill = "white", colour = NA),
    legend.position    = "top"
  )

ggsave("age_density_by_income.png", width = 7, height = 5, dpi = 300)
```

