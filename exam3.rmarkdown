## Quarto

Quarto enables you to weave together content and executable code into a finished document. To learn more about Quarto see <https://quarto.org>.

## Running Code

When you click the **Render** button a document will be generated that includes both content and the output of embedded code. You can embed code like this:



```{r}
if (!requireNamespace("xfun", quietly = TRUE)) {
install.packages("xfun")
}
if (!requireNamespace("mlr", quietly = TRUE)) {
install.packages("mlr")
}
if (!requireNamespace("GGally", quietly = TRUE)) {
install.packages("GGally")
}

library(readr)
library(skimr)
library(janitor)
library(dplyr)
library(tidyr)
library(tidyverse)    
library(recipes)      
library(rsample)    
library(yardstick)  
library(vip)
library(knitr) 
library(hardhat)   
library(themis)
library(tune)
library(parsnip)
library(workflows)
library(parallel)
library(doParallel)
library(tidymodels)
library(knitr)
library(pdp)
library(lime)
library(ggplot2)
library(tibble)
library(scales)
library(forcats)

```

```{r}
csv_path <- "adult.csv" 

adult_df <- read_csv(csv_path, show_col_types = FALSE)

cat("Dimensions of adult_df (rows, columns):\n")
print(dim(adult_df))

skim(adult_df)

cat("\nIncome class distribution:\n")
adult_df %>%
  count(income) %>%                     
  mutate(proportion = n / sum(n)) %>%   
  kable(digits = 3, 
        col.names = c("Income", "Count", "Proportion"))

cat("\nFirst 6 rows of the dataset:\n")
print(head(adult_df, 6))

cat("\nCounts of '?' entries in character columns:\n")
adult_df %>%
  summarize(across(where(is.character), ~ sum(. == "?", na.rm = TRUE))) %>%
  pivot_longer(everything(), names_to = "column", values_to = "count_question") %>%
  arrange(desc(count_question)) %>%
  kable(col.names = c("Column", "Count of '?'"))

adult_clean <- adult_df %>%
  mutate(across(
    .cols = where(is.character),
    .fns  = ~ na_if(., "?")                  
  )) %>%
  mutate(across(
    .cols = where(is.character),
    .fns  = ~ replace_na(., "Unknown")       
  ))

cat("\nCounts of 'Unknown' after recoding:\n")
adult_clean %>%
  summarize(across(where(is.character), ~ sum(. == "Unknown", na.rm = TRUE))) %>%
  pivot_longer(everything(), names_to = "column", values_to = "count_unknown") %>%
  arrange(desc(count_unknown)) %>%
  kable(col.names = c("Column", "Count of 'Unknown'"))
```

```{r}
clr_low  <- "#3182BD"  
clr_high <- "#FFD54F" 

ggplot(adult_clean, aes(x = income, fill = income)) +
  geom_bar() +
  geom_text(
    stat  = "count",
    aes(label = comma(after_stat(count))),
    vjust = -0.30, size = 5, colour = "white"
  ) +
  scale_fill_manual(
    values = c("<=50K" = clr_low,
               ">50K"  = clr_high),
    guide  = "none"               # hide legend (optional)
  ) +
  labs(
    title = "Class Distribution in Adult Census Income Data",
    x     = "Income Class",
    y     = "Count of Individuals"
  ) +
  theme_minimal(base_size = 14)

ggsave("class_distribution.png", width = 6, height = 4, dpi = 300)
```

```{r}
feat_type_vec <- sapply(adult_clean %>% select(-income), is.numeric)
type_tbl <- tibble(
  feature   = names(feat_type_vec),
  feat_type = ifelse(feat_type_vec, "Numeric", "Categorical")
)

known_counts <- adult_clean %>% 
  select(-income) %>% 
  summarise(across(
    everything(),
    ~ if (is.numeric(.x)) {
        sum(!is.na(.x))                      
      } else {
        sum(as.character(.x) != "Unknown")  
      }
  )) %>% 
  pivot_longer(everything(),
               names_to  = "feature",
               values_to = "n_known") %>% 
  left_join(type_tbl, by = "feature") %>%    # add type label
  mutate(feature = fct_reorder(feature, n_known))

ggplot(known_counts,
       aes(x = feature, y = n_known, fill = feat_type)) +
  geom_col(width = 0.7) +
  labs(title    = "How Complete Is Each Feature?",
       subtitle = "Count of observations with a *known* value",
       x        = NULL,
       y        = "Number of Known Rows",
       fill     = "Feature Type") +
  scale_fill_manual(values = c("Numeric"     = "#FF6FA8",
                               "Categorical" = "#FFD54F")) +
  theme_minimal(base_size = 13) +
  theme(
    plot.background      = element_rect(fill = "white", colour = NA),
    panel.grid.major.x   = element_blank(),
    panel.grid.minor     = element_blank(),
    axis.text.x          = element_text(angle = 45, hjust = 1, vjust = 1),
    axis.title.y         = element_text(margin = margin(r = 10)),
    plot.title           = element_text(face = "bold", size = 16),
    plot.subtitle        = element_text(size = 12, margin = margin(b = 8))
  ) +
  scale_y_continuous(expand = expansion(mult = c(0, 0.05)))

ggsave("known_values_by_feature_type.png",
       width = 8, height = 5, dpi = 400)
```

```{r}
edu_income <- adult_clean %>%                             
  mutate(high_income = income == ">50K") %>%              
  group_by(education) %>%                                
  summarise(share_gt50k = mean(high_income),              
            n           = n()) %>%                        
  arrange(desc(share_gt50k))                              

ggplot(edu_income, aes(x = reorder(education, share_gt50k),
                       y = share_gt50k)) +
  geom_col(fill = "#2171b5") +                            
  coord_flip() +                                          
  scale_y_continuous(labels = percent_format()) +
  labs(title   = "Share of >$50K Earners by Education Level",
       x       = "Education Level",
       y       = "% of Group Earning >$50K") +
  theme_minimal(base_size = 14)

ggsave("education_income_share.png",
       width = 8, height = 5, dpi = 300)

```

```{r}
col_low  <- "#3182BD"  
